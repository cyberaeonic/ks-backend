# =============================
# Sree Meenakshi Handicrafts - Backend .env
# Copy this to .env and fill in your values
# =============================

# MySQL Database URL (Prisma)
DATABASE_URL="mysql://root:yourpassword@localhost:3306/krishika_shop"

# Server port (default 3001)
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Razorpay Secret Key (get from Razorpay Dashboard > Settings > API Keys)
# The Key ID is stored in admin panel settings
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# NextAuth URL (if applicable)
NEXTAUTH_URL=http://localhost:3000
